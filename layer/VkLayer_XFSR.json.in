{
  "file_format_version": "1.2.0",
  "layer": {
    "name": "VK_LAYER_XFSR",
    "type": "GLOBAL",
    "library_path": "@LAYER_LIB_PATH@",
    "api_version": "1.3.0",
    "implementation_version": "6",
    "description": "xfsr FSR1 (same-GPU or dGPU render → iGPU FSR/present)",
    "functions": {
      "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
    },
    "enable_environment": {
      "ENABLE_XFSR": "1"
    },
    "disable_environment": {
      "DISABLE_XFSR": "1"
    }
  }
}

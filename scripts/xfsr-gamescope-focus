#!/usr/bin/env bash
# Autofocus the game window inside a nested gamescope Xwayland.
# Desktop Steam + gamescope (not gamescope-session) often leaves
# GAMESCOPE_FOCUSED_* empty → black nest even while the game renders.
# ChimeraOS-style: STEAM_GAME on the window + GAMESCOPECTRL_BASELAYER_APPID.
set -euo pipefail

APP_ID="${SteamAppId:-${SteamAppID:-${SteamGameId:-${XFSR_STEAM_APPID:-0}}}}"

focus_loop() {
  command -v xprop >/dev/null 2>&1 || return 0
  local i win app
  for i in $(seq 1 240); do
    sleep 0.25
    [[ -n "${DISPLAY:-}" ]] || continue
    # Already focused with gfx? done.
    if xprop -root GAMESCOPE_FOCUSED_APP_GFX 2>/dev/null | grep -q '= [1-9]'; then
      return 0
    fi
    # FOCUSABLE_WINDOWS: xid, appid, pid (repeat). Without -e, appid is often the
    # xid itself (not SteamAppId) — BASELAYER must match that value or GFX focus
    # never sticks (black nest). Prefer the tuple's appid for baselayer.
    local raw
    raw="$(xprop -root GAMESCOPE_FOCUSABLE_WINDOWS 2>/dev/null || true)"
    raw="${raw#*=}"
    raw="${raw//,/ }"
    # shellcheck disable=SC2086
    set -- $raw
    while [[ $# -ge 3 ]]; do
      win="$1"
      app="$2"
      shift 3
      local win_dec="$1"
      [[ "$win" =~ ^0x ]] || win=$(printf '0x%x' "$win_dec" 2>/dev/null || echo "$win")
      # Without -e, gamescope lists appid == window xid. Always try those.
      # If appid is a real Steam id and doesn't match ours, skip.
      if [[ "$APP_ID" != "0" && "$app" != "$APP_ID" && "$app" != "$win_dec" ]]; then
        continue
      fi
      local steam_tag="$APP_ID"
      [[ "$steam_tag" == "0" ]] && steam_tag="$app"
      xprop -id "$win" -f STEAM_GAME 32c -set STEAM_GAME "$steam_tag" 2>/dev/null || true
      # Baselayer must match FOCUSABLE_APPS (xid when not in Steam -e mode).
      xprop -root -f GAMESCOPECTRL_BASELAYER_APPID 32c -set GAMESCOPECTRL_BASELAYER_APPID "$app" 2>/dev/null || true
      xprop -root -f GAMESCOPECTRL_BASELAYER_WINDOW 32c -set GAMESCOPECTRL_BASELAYER_WINDOW "$win" 2>/dev/null || true
      sleep 0.15
      if xprop -root GAMESCOPE_FOCUSED_APP_GFX 2>/dev/null | grep -q '= [1-9]'; then
        echo "xfsr-gamescope-focus: focused win=$win baselayer_app=$app steam=$steam_tag" >&2
        return 0
      fi
    done
  done
  echo "xfsr-gamescope-focus: timed out waiting for focusable window" >&2
}

# Must disown: plain "bg &; exec" gets SIGHUP when this shell is replaced.
focus_loop &
disown || true
exec "$@"

#!/usr/bin/env bash
# xfsr-run — dual-GPU FSR via Vulkan layer (gamemoderun-style).
#
# Steam:  xfsr-run --mangohud --preset performance %command%
#
# Layer: dGPU low-res → shared-host DMA → iGPU FSR1 → present (demo mode 2).

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
# Prefer an explicit XFSR_BUILD only if it actually contains the layer; otherwise
# a stale export from testing points Proton at a host path pressure-vessel cannot see.
BUILD=""
if [[ -n "${XFSR_BUILD:-}" && -f "${XFSR_BUILD}/VkLayer_XFSR.json" ]]; then
  BUILD="$XFSR_BUILD"
else
  BUILD="$ROOT/build"
fi
LAYER_DIR=""
PRINT_ONLY=0
# Zink mode: 0=off, 1=on, 2=auto (default). Auto enables Zink for native OpenGL
# (glmark2, etc.) and leaves it off for Proton/Wine/Vulkan-native titles.
USE_ZINK=2
ZINK_CLI=0
USE_NESTED=0
USE_MANGOHUD=0
PREFER_DGPU=1
# Do NOT inherit ambient XFSR_OUTPUT_* / DISPLAY_EXTENT — glmark2 tests leave
# 800x600 in the session and Steam then force-scales CS2 to a postage stamp.
OUT_W=1920
OUT_H=1080
OUT_CLI=0
PRESET="${XFSR_PRESET:-${CROSSVULKAN_PRESET_MODE:-quality}}"
FSR="${XFSR_FSR:-${CROSSVULKAN_FSR:-1}}"
# Default same-GPU FSR. Do NOT inherit ambient XFSR_OFFLOAD — Steam/sessions
# often keep a stale =1 from testing, which enables dual-GPU DMA and can crash CS2.
OFFLOAD=0
OFFLOAD_CLI=0
# Empty = layer default (NVIDIA→round-trip, Mesa→try one-way). CLI sets 0|1.
ONE_WAY=""
ONE_WAY_CLI=0
RCAS="${XFSR_RCAS:-${CROSSVULKAN_RCAS:-1}}"

if [[ "${XFSR_MANGOHUD:-0}" == "1" ]]; then
  USE_MANGOHUD=1
fi
if [[ "${XFSR_ZINK:-}" == "1" ]]; then
  USE_ZINK=1
  ZINK_CLI=1
elif [[ "${XFSR_ZINK:-}" == "0" ]]; then
  USE_ZINK=0
  ZINK_CLI=1
fi

usage() {
  cat <<'EOF'
Usage: xfsr-run [options] [--] <command> [args...]

Options:
  --preset quality|balanced|performance|ultra   FSR scale (default: quality)
                                          ultra = 2.5× (weak GPUs / max FPS)
  --fsr 0|1                               native / FSR1 (default: 1; FSR3 demo-only; FSR4 not yet)
  --offload / --no-offload                dual-GPU: dGPU render + iGPU FSR (off by default;
                                          use for hybrid NVIDIA+AMD max throughput;
                                          can still stress some Proton titles — try without if unstable)
  --one-way / --no-one-way                with --offload: prefer iGPU present or force
                                          round-trip; implies --offload. On NVIDIA, --one-way
                                          is ignored (SIGSEGV); XFSR_IGPU_PRESENT=force to try.
  --rcas / --no-rcas                      FSR1 sharpening pass (default: on; --no-rcas = EASU only)
  --zink / --no-zink                      Mesa Zink for OpenGL→Vulkan (default: auto —
                                          on for glmark2/native GL, off for Proton/Vulkan)
  --mangohud / --hud                      FPS/frametime overlay (GL preload and/or Vulkan layer)
  --igpu                                  Prefer iGPU ICD (default: prefer dGPU)
  --layer-dir DIR                         directory with VkLayer_XFSR.json
  --print                                 print env / command, then exit
  -h, --help

  --nested / --gamescope                  Deprecated (second compositor; not dual-GPU FSR)

Env: XFSR_*, XFSR_VERBOSE=1, XFSR_MANGOHUD=1, XFSR_ZINK=0|1

Steam / Vulkan:  xfsr-run --mangohud --preset ultra --offload --no-rcas %command%
OpenGL:          xfsr-run --mangohud --preset ultra --offload --no-rcas glmark2
EOF
}

scale_for_preset() {
  case "$1" in
    ultra|U|extreme) echo 2.5 ;;
    performance|perf|E) echo 2.0 ;;
    balanced|W) echo 1.7 ;;
    *) echo 1.5 ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --print) PRINT_ONLY=1; shift ;;
    --zink) USE_ZINK=1; ZINK_CLI=1; shift ;;
    --no-zink) USE_ZINK=0; ZINK_CLI=1; shift ;;
    --auto-zink) USE_ZINK=2; ZINK_CLI=1; shift ;;
    --nested|--gamescope) USE_NESTED=1; shift ;;
    --mangohud|--hud) USE_MANGOHUD=1; shift ;;
    --no-mangohud|--no-hud) USE_MANGOHUD=0; shift ;;
    --igpu) PREFER_DGPU=0; shift ;;
    --output)
      OUT_W="${2%%x*}"; OUT_H="${2##*x}"; OUT_CLI=1; shift 2 ;;
    --output=*)
      o="${1#*=}"; OUT_W="${o%%x*}"; OUT_H="${o##*x}"; OUT_CLI=1; shift ;;
    --preset)
      PRESET="${2:?}"; shift 2 ;;
    --preset=*) PRESET="${1#*=}"; shift ;;
    --fsr)
      FSR="${2:?}"; shift 2 ;;
    --fsr=*) FSR="${1#*=}"; shift ;;
    --offload) OFFLOAD=1; OFFLOAD_CLI=1; shift ;;
    --no-offload) OFFLOAD=0; OFFLOAD_CLI=1; shift ;;
    --one-way) ONE_WAY=1; ONE_WAY_CLI=1; OFFLOAD=1; OFFLOAD_CLI=1; shift ;;
    --no-one-way) ONE_WAY=0; ONE_WAY_CLI=1; shift ;;
    --rcas) RCAS=1; shift ;;
    --no-rcas) RCAS=0; shift ;;
    --layer-dir)
      LAYER_DIR="${2:?}"; shift 2 ;;
    --layer-dir=*) LAYER_DIR="${1#*=}"; shift ;;
    --) shift; break ;;
    -*)
      echo "xfsr-run: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *) break ;;
  esac
done

case "$FSR" in
  0|1|3) ;;
  4)
    echo "xfsr-run: FSR 4 is not available on Vulkan yet (AMD FSR SDK 2.x is DX12-only;" >&2
    echo "  Vulkan support is planned for SDK 2.4). Use --fsr 1 (layer) or demo --fsr 3." >&2
    exit 2
    ;;
  *)
    echo "xfsr-run: invalid --fsr '$FSR' (use 0, 1, or 3; 4 not available on Vulkan)" >&2
    exit 2
    ;;
esac

if [[ $# -eq 0 && $PRINT_ONLY -eq 0 ]]; then
  usage >&2
  exit 1
fi

find_layer_dir() {
  # Installed ~/.local first for Steam/Proton (pressure-vessel sees $HOME).
  # Dev build next so local iteration still works outside Steam.
  local candidates=(
    "${LAYER_DIR}"
    "${XFSR_LAYER_PATH:-}"
    "${HOME}/.local/share/vulkan/implicit_layer.d"
    "${BUILD}"
    "/usr/share/vulkan/implicit_layer.d"
  )
  local d
  for d in "${candidates[@]}"; do
    [[ -n "$d" ]] || continue
    if [[ -f "$d/VkLayer_XFSR.json" ]]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

ensure_built() {
  if [[ -f "$BUILD/libVkLayer_XFSR.so" && -f "$BUILD/VkLayer_XFSR.json" &&
        -f "$BUILD/libxfsr_gl_shim.so" ]]; then
    return 0
  fi
  if [[ -f "$ROOT/CMakeLists.txt" ]]; then
    echo "xfsr-run: building layer + GL shim in $BUILD ..." >&2
    cmake -S "$ROOT" -B "$BUILD" -DCMAKE_BUILD_TYPE=Release \
      -DXFSR_BUILD_DEMO=OFF -DXFSR_BUILD_BENCH=OFF
    cmake --build "$BUILD" -j --target VkLayer_XFSR xfsr_gl_shim
  fi
}

require_mangohud() {
  if [[ $USE_MANGOHUD -eq 0 ]]; then
    return 0
  fi
  if ! command -v mangohud >/dev/null 2>&1 && [[ ! -e /usr/lib/mangohud/libMangoHud.so ]]; then
    echo "xfsr-run: mangohud not found (install mangohud, or drop --mangohud)" >&2
    exit 1
  fi
}

# Proton / Wine / Steam Linux Runtime → never force Zink (breaks DXVK/Vulkan).
command_looks_proton() {
  local a
  for a in "$@"; do
    case "$a" in
      *proton*|*Proton*|*wine*|*Wine*|*waitforexitandrun*|*steam-runtime*|*pressure-vessel*|*reaper*)
        return 0 ;;
    esac
  done
  [[ -n "${SteamGameId:-}${SteamAppId:-}${STEAM_COMPAT_DATA_PATH:-}" ]] && return 0
  return 1
}

# Native OpenGL tools / games that need Zink for the Vulkan FSR layer.
command_looks_opengl() {
  local a base
  for a in "$@"; do
    [[ "$a" == "--" ]] && continue
    base="$(basename "$a" 2>/dev/null || echo "$a")"
    case "$base" in
      glmark2|glmark2-es2|glmark2-wayland|glxgears|glxinfo|xfsr_load_gl)
        return 0 ;;
    esac
    case "$a" in
      *glmark2*|*glxgears*|*xfsr_load_gl*) return 0 ;;
    esac
  done
  return 1
}

resolve_zink_mode() {
  if [[ $ZINK_CLI -eq 1 ]]; then
    return 0
  fi
  if [[ $USE_ZINK -ne 2 ]]; then
    return 0
  fi
  if command_looks_proton "$@"; then
    USE_ZINK=0
    echo "xfsr-run: auto: Proton/Wine detected — Zink off (Vulkan/DXVK path)." >&2
  elif command_looks_opengl "$@"; then
    USE_ZINK=1
    echo "xfsr-run: auto: OpenGL title — enabling Zink for FSR." >&2
  else
    # Unknown native binary: keep Vulkan path (vkcube, native VK games).
    USE_ZINK=0
  fi
}

find_mangohud_opengl() {
  # Prefer the official mangohud launcher shim (hooks SwapBuffers + loads opengl.so).
  # Plain libMangoHud_opengl.so alone is often bypassed when our viewport shim
  # owns glXGetProcAddress/dlsym first.
  local cand
  for cand in \
    /usr/lib/mangohud/libMangoHud_shim.so \
    /usr/lib64/mangohud/libMangoHud_shim.so \
    /usr/lib/mangohud/libMangoHud_opengl.so \
    /usr/lib64/mangohud/libMangoHud_opengl.so; do
    if [[ -f "$cand" ]]; then
      echo "$cand"
      return 0
    fi
  done
  return 1
}

run_with_hud() {
  if [[ $USE_MANGOHUD -eq 1 ]]; then
    export MANGOHUD=1
    if [[ $USE_ZINK -eq 1 ]]; then
      # Zink presents through our Vulkan layer. A GL MangoHud (SwapBuffers) paints
      # Zink's GL surface which XFSR never samples — HUD vanishes after FSR.
      # Use the Vulkan MangoHud layer instead (same as native VK). Keep only the
      # viewport shim in LD_PRELOAD — do not LD_PRELOAD libMangoHud*.so here.
      # Strip any mangohud libs an outer wrapper may have injected.
      if [[ -n "${LD_PRELOAD:-}" ]]; then
        local cleaned="" part
        IFS=':' read -r -a _lp <<<"$LD_PRELOAD"
        for part in "${_lp[@]}"; do
          case "$part" in
            *MangoHud*|*mangohud*) continue ;;
          esac
          cleaned="${cleaned:+$cleaned:}$part"
        done
        export LD_PRELOAD="$cleaned"
      fi
      # Ensure MH Vulkan layer is not disabled by ambient env.
      if [[ -n "${VK_LOADER_LAYERS_DISABLE:-}" ]]; then
        export VK_LOADER_LAYERS_DISABLE="$(
          echo "$VK_LOADER_LAYERS_DISABLE" | sed -e 's/VK_LAYER_MANGOHUD_overlay_x86_64,//g' \
            -e 's/VK_LAYER_MANGOHUD_overlay_x86,//g' -e 's/,VK_LAYER_MANGOHUD_overlay_x86_64//g' \
            -e 's/,VK_LAYER_MANGOHUD_overlay_x86//g'
        )"
      fi
      echo "xfsr-run: MangoHud via Vulkan layer (Zink+XFSR; GL HUD would be dropped)." >&2
    fi
    # Native Vulkan / Proton: MANGOHUD=1 enables the implicit Vulkan layer only
    # (no mangohud LD_PRELOAD wrapper — that fights XFSR present).
    exec "$@"
  else
    exec "$@"
  fi
}

case "$PRESET" in
  quality|balanced|performance|ultra|Q|W|E|U|extreme) ;;
  *)
    echo "xfsr-run: bad --preset '$PRESET' (quality|balanced|performance|ultra)" >&2
    exit 2
    ;;
esac
case "$FSR" in
  0|1|3) ;;
  *)
    echo "xfsr-run: bad --fsr '$FSR'" >&2
    exit 2
    ;;
esac

SCALE="$(scale_for_preset "$PRESET")"
RENDER_W="$(awk -v w="$OUT_W" -v s="$SCALE" 'BEGIN{printf "%d", w/s+0.5}')"
RENDER_H="$(awk -v h="$OUT_H" -v s="$SCALE" 'BEGIN{printf "%d", h/s+0.5}')"
RENDER_W=$(( RENDER_W < 64 ? 64 : RENDER_W ))
RENDER_H=$(( RENDER_H < 64 ? 64 : RENDER_H ))
if [[ "$OUT_W" == "1920" && "$OUT_H" == "1080" ]]; then
  case "$PRESET" in
    ultra|U|extreme) RENDER_W=768; RENDER_H=432 ;;
    performance|perf|E) RENDER_W=960; RENDER_H=540 ;;
    balanced|W) RENDER_W=1129; RENDER_H=635 ;;
    *) RENDER_W=1280; RENDER_H=720 ;;
  esac
fi

require_mangohud

if [[ $USE_NESTED -eq 1 ]]; then
  echo "xfsr-run: --nested is deprecated (gamescope is not dual-GPU FSR). Using Vulkan layer." >&2
fi

# Resolve auto-Zink from the real command line (after options).
if [[ $PRINT_ONLY -eq 0 ]]; then
  resolve_zink_mode "$@"
elif [[ $USE_ZINK -eq 2 ]]; then
  USE_ZINK=0
fi

ensure_built
LAYER_DIR="$(find_layer_dir)" || {
  echo "xfsr-run: layer JSON not found. Try: ./scripts/install-xfsr-run.sh" >&2
  exit 1
}

# SPIR-V for the layer (installed under share/xfsr/shaders, or build/shaders).
if [[ -z "${XFSR_SHADER_DIR:-}" ]]; then
  for d in \
    "${ROOT}/share/xfsr/shaders" \
    "${HOME}/.local/share/xfsr/shaders" \
    "${BUILD}/shaders" \
    "${ROOT}/build/shaders"; do
    if [[ -f "$d/fsr_easu_fp32.comp.spv" ]]; then
      export XFSR_SHADER_DIR="$d"
      break
    fi
  done
fi

# Valve/pressure-vessel: do NOT set VK_IMPLICIT_LAYER_PATH / VK_LAYER_PATH — they
# replace XDG discovery and break imported host layers inside the container.
# Prefer manifests under ~/.local/share/vulkan (XDG) like the Steam overlay.
# VK_ADD_IMPLICIT_LAYER_PATH is optional on the host; clear stale project build/ paths.
unset VK_LAYER_PATH VK_IMPLICIT_LAYER_PATH 2>/dev/null || true
export VK_ADD_IMPLICIT_LAYER_PATH="${LAYER_DIR}"
# Prepend ~/.local/share for our layer JSON, but NEVER drop system dirs — an
# XDG_DATA_DIRS that is only ~/.local/share hides /usr/share/vulkan/icd.d and
# Zink dies with VK_ERROR_INCOMPATIBLE_DRIVER ("Found no drivers").
if [[ -z "${XDG_DATA_DIRS:-}" ]]; then
  export XDG_DATA_DIRS="${HOME}/.local/share:/usr/local/share:/usr/share"
else
  export XDG_DATA_DIRS="${HOME}/.local/share:${XDG_DATA_DIRS}"
fi
_pv_rw="${HOME}/.local"
[[ -n "${XFSR_SHADER_DIR:-}" ]] && _pv_rw="${_pv_rw}:${XFSR_SHADER_DIR}"
export PRESSURE_VESSEL_FILESYSTEMS_RW="${_pv_rw}${PRESSURE_VESSEL_FILESYSTEMS_RW:+:$PRESSURE_VESSEL_FILESYSTEMS_RW}"
# Extra bind for Proton (some SLR builds honor this more reliably than PV_RW alone).
export STEAM_COMPAT_MOUNTS="${HOME}/.local${STEAM_COMPAT_MOUNTS:+:$STEAM_COMPAT_MOUNTS}"
unset _pv_rw
export ENABLE_XFSR=1
unset DISABLE_XFSR 2>/dev/null || true
# Do not set VK_LOADER_LAYERS_ENABLE by default — a failed dlopen then aborts
# CreateInstance (black screen / instant exit) instead of skipping the layer.
export XFSR_FSR="$FSR"
export XFSR_PRESET="$PRESET"
export XFSR_OFFLOAD="$OFFLOAD"
export XFSR_RCAS="$RCAS"
if [[ $ONE_WAY_CLI -eq 1 ]]; then
  export XFSR_IGPU_PRESENT="$ONE_WAY"
fi
# Wayland: ICD currentExtent is often UINT_MAX — seed the layer so caps-shrink works
# on the first CreateSwapchain (otherwise identity @ full res, flat bench FPS).
export XFSR_OUTPUT_W="$OUT_W"
export XFSR_OUTPUT_H="$OUT_H"
export XFSR_DISPLAY_W="$OUT_W"
export XFSR_DISPLAY_H="$OUT_H"
export XFSR_RENDER_W="$RENDER_W"
export XFSR_RENDER_H="$RENDER_H"
export XFSR_SCALE="$SCALE"
export XFSR_DISPLAY_EXTENT="${OUT_W}x${OUT_H}"
# Layer FSR1 pass follows XFSR_FSR unless explicitly overridden.
if [[ -z "${XFSR_LAYER_FSR:-}" ]]; then
  export XFSR_LAYER_FSR="$FSR"
fi

_ow_msg=""
if [[ -n "${XFSR_IGPU_PRESENT:-}" ]]; then
  if [[ "$XFSR_IGPU_PRESENT" == "1" ]]; then _ow_msg=" one-way=1"; else _ow_msg=" one-way=0"; fi
fi
echo "xfsr-run: layer ${LAYER_DIR} (ENABLE_XFSR=1 preset=$PRESET scale=$SCALE offload=$OFFLOAD${_ow_msg})" >&2
unset _ow_msg

if [[ $USE_ZINK -eq 1 ]]; then
  export MESA_LOADER_DRIVER_OVERRIDE=zink
  export GALLIUM_DRIVER=zink
  # Wayland-only binaries (glmark2-wayland, *-wayland) die if we clear WAYLAND_DISPLAY.
  _cmd_base="$(basename -- "${1:-}" 2>/dev/null || true)"
  if [[ "${XFSR_ZINK_WAYLAND:-}" != "1" && "${XFSR_ZINK_WAYLAND:-}" != "0" ]]; then
    case "$_cmd_base" in
      *-wayland|wayland*|*wayland*) export XFSR_ZINK_WAYLAND=1 ;;
    esac
  fi
  unset _cmd_base
  # Wayland ignores shrunk currentExtent (swapchain = window). Prefer X11 for FSR
  # unless the app needs Wayland or XFSR_ZINK_WAYLAND=1.
  if [[ -n "${WAYLAND_DISPLAY:-}" && "${XFSR_ZINK_WAYLAND:-0}" != "1" ]]; then
    unset WAYLAND_DISPLAY WAYLAND_SOCKET
    echo "xfsr-run: Zink FSR prefers X11 — cleared WAYLAND_DISPLAY (XFSR_ZINK_WAYLAND=1 to keep)." >&2
  elif [[ -n "${WAYLAND_DISPLAY:-}" && "${XFSR_ZINK_WAYLAND:-0}" == "1" ]]; then
    echo "xfsr-run: keeping Wayland for Zink (XFSR_ZINK_WAYLAND=1)." >&2
  fi
  # Remap glViewport/glScissor from window size → render size (fixes lower-left corner).
  SHIM=""
  for d in "${HOME}/.local/lib" "$BUILD" "$ROOT/lib" "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/../lib"; do
    if [[ -f "$d/libxfsr_gl_shim.so" ]]; then
      SHIM="$d/libxfsr_gl_shim.so"
      break
    fi
  done
  if [[ -n "$SHIM" ]]; then
    export LD_PRELOAD="${SHIM}${LD_PRELOAD:+:$LD_PRELOAD}"
    echo "xfsr-run: Zink + FSR (shim $SHIM, render ${RENDER_W}x${RENDER_H})." >&2
  else
    echo "xfsr-run: warning: libxfsr_gl_shim.so not found — OpenGL may show a corner crop. Build/install xfsr." >&2
  fi
else
  # Clear ambient Zink (shell/Steam often keep GALLIUM_DRIVER=zink from testing).
  # Leaving it set breaks native Vulkan (CS2) and Proton/DXVK.
  unset MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER 2>/dev/null || true
  # Do NOT set DRI_PRIME=1 — on NVIDIA+AMD hybrids it forces the iGPU / breaks Proton.
  unset DRI_PRIME 2>/dev/null || true
  echo "xfsr-run: Vulkan/Proton path (no Zink). OpenGL titles need --zink for FSR." >&2
fi

# Dual-GPU: keep both ICDs visible (do not set VK_ICD_FILENAMES to one GPU).
# Prefer discrete via Mesa device-select when available (RADV/AMDVLK). NVIDIA ICD
# ignores MESA_VK_DEVICE_SELECT; unset FORCE so both GPUs stay enumerable for --offload.
if [[ $PREFER_DGPU -eq 1 ]]; then
  if [[ -z "${MESA_VK_DEVICE_SELECT:-}" ]] && command -v vulkaninfo >/dev/null 2>&1; then
    dgpu_id="$(
      env -u ENABLE_XFSR -u VK_ADD_IMPLICIT_LAYER_PATH -u VK_LAYER_PATH \
        MESA_VK_DEVICE_SELECT=list vulkaninfo --summary 2>&1 \
        | awk '/discrete GPU/{ if (match($0, /[0-9a-fA-F]+:[0-9a-fA-F]+/)) {
            print substr($0, RSTART, RLENGTH); exit } }' || true
    )"
    if [[ -n "$dgpu_id" ]]; then
      export MESA_VK_DEVICE_SELECT="$dgpu_id"
      unset MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE 2>/dev/null || true
    fi
  fi
fi

# An empty VK_ICD_FILENAMES / VK_DRIVER_FILES means "no drivers" to the loader.
# Unset so hybrid NVIDIA+AMD ICDs are discovered normally. Same for DRI_PRIME=.
if [[ -z "${VK_ICD_FILENAMES:-}" ]]; then
  unset VK_ICD_FILENAMES 2>/dev/null || true
fi
if [[ -z "${VK_DRIVER_FILES:-}" ]]; then
  unset VK_DRIVER_FILES 2>/dev/null || true
fi
if [[ -z "${DRI_PRIME:-}" ]]; then
  unset DRI_PRIME 2>/dev/null || true
fi

if [[ $PRINT_ONLY -eq 1 ]]; then
  cat <<EOF
VK_ADD_IMPLICIT_LAYER_PATH=$VK_ADD_IMPLICIT_LAYER_PATH
ENABLE_XFSR=$ENABLE_XFSR
XFSR_SHADER_DIR=${XFSR_SHADER_DIR:-}
XFSR_FSR=$XFSR_FSR
XFSR_LAYER_FSR=${XFSR_LAYER_FSR:-}
XFSR_PRESET=$XFSR_PRESET
XFSR_OFFLOAD=$XFSR_OFFLOAD
XFSR_IGPU_PRESENT=${XFSR_IGPU_PRESENT:-}
XFSR_RCAS=$XFSR_RCAS
XFSR_DISPLAY_EXTENT=${XFSR_DISPLAY_EXTENT:-}
XFSR_OUTPUT_W=${XFSR_OUTPUT_W:-}
XFSR_OUTPUT_H=${XFSR_OUTPUT_H:-}
XFSR_DISPLAY_W=${XFSR_DISPLAY_W:-}
XFSR_DISPLAY_H=${XFSR_DISPLAY_H:-}
XFSR_RENDER_W=${XFSR_RENDER_W:-}
XFSR_RENDER_H=${XFSR_RENDER_H:-}
LD_PRELOAD=${LD_PRELOAD:-}
MESA_LOADER_DRIVER_OVERRIDE=${MESA_LOADER_DRIVER_OVERRIDE:-}
MESA_VK_DEVICE_SELECT=${MESA_VK_DEVICE_SELECT:-}
DRI_PRIME=${DRI_PRIME:-}
VK_ICD_FILENAMES=${VK_ICD_FILENAMES:-}
MANGOHUD=${USE_MANGOHUD}
layer_dir=$LAYER_DIR
EOF
  exit 0
fi

run_with_hud "$@"
